{
  "name": "callerflash",
  "private": true,
  "version": "1.7.17",
  "author": "CallerFlash",
  "description": "SIP-compliant client with toast notifications for any standard SIP provider",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "npx @tauri-apps/cli@^2 dev",
    "build": "vite build",
    "build:tauri": "vite build && npx @tauri-apps/cli@^2 build --bundles nsis",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "clsx": "2.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.21.0",
    "prettier": "^3.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.1.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
