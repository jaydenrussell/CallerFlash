{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CallerFlash",
  "version": "2.3.5-beta",
  "identifier": "com.callerflash.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "CallerFlash — SIP Client",
        "label": "main",
        "width": 1000,
        "height": 700,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OEI0NUQ1QzZDMTE5RDcKUldUWEdjSEcxVVdMeHJscDAvMjRNQndSYm93S2wxQmJyK0o0OGU0cWUvK0MweFlVTzhpbVZUSDQK",
      "endpoints": [
        "https://github.com/jaydenrussell/CallerFlash/releases/latest/download/update.json"
      ],
      "dangerousInsecureTransportProtocol": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "CallerFlash",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}
